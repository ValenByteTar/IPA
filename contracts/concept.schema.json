{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://res023-lab/contracts/concept.schema.json",
  "title": "Concept",
  "description": "A teachable concept with source-backed claims kept separate from generated pedagogical material.",
  "type": "object",
  "additionalProperties": false,
  "required": ["concept_id", "title", "definition", "status", "difficulty", "prerequisite_ids", "learning_objectives", "mastery_criteria", "source_refs", "created_at", "updated_at", "generation", "field_origins"],
  "properties": {
    "concept_id": { "$ref": "tutor_common.schema.json#/$defs/identifier", "x-field-origin": "system" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200, "x-field-origin": "source_or_generated" },
    "definition": { "type": "string", "minLength": 1, "maxLength": 4000, "x-field-origin": "source_or_generated" },
    "status": { "type": "string", "enum": ["draft", "validated", "deprecated"], "x-field-origin": "system" },
    "difficulty": { "type": "number", "minimum": 0, "maximum": 1, "x-field-origin": "generated_or_manual" },
    "prerequisite_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 50,
      "items": { "$ref": "tutor_common.schema.json#/$defs/identifier" },
      "x-field-origin": "source_or_generated"
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "x-field-origin": "generated_or_manual"
    },
    "mastery_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "x-field-origin": "generated_or_manual"
    },
    "common_misconceptions": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "default": [],
      "x-field-origin": "source_or_generated"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "tutor_common.schema.json#/$defs/sourceRef" },
      "x-field-origin": "source"
    },
    "created_at": { "$ref": "tutor_common.schema.json#/$defs/timestamp", "x-field-origin": "system" },
    "updated_at": { "$ref": "tutor_common.schema.json#/$defs/timestamp", "x-field-origin": "system" },
    "generation": {
      "anyOf": [{ "$ref": "tutor_common.schema.json#/$defs/generationProvenance" }, { "type": "null" }],
      "x-field-origin": "system"
    },
    "field_origins": {
      "type": "object",
      "additionalProperties": { "$ref": "tutor_common.schema.json#/$defs/fieldOrigin" },
      "required": ["title", "definition", "difficulty", "prerequisite_ids", "learning_objectives", "mastery_criteria"],
      "x-field-origin": "system"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "validated" } }, "required": ["status"] },
      "then": { "properties": { "source_refs": { "minItems": 1 } } }
    }
  ]
}
