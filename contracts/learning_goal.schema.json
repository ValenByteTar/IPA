{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://res023-lab/contracts/learning_goal.schema.json",
  "title": "LearningGoal",
  "description": "User-defined or user-confirmed learning objective. The tutor may propose a goal but cannot confirm it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal_id", "title", "description", "status", "success_criteria", "created_at", "updated_at", "approval", "field_origins"],
  "properties": {
    "goal_id": { "$ref": "tutor_common.schema.json#/$defs/identifier", "x-field-origin": "system" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200, "x-field-origin": "user_or_generated" },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000, "x-field-origin": "user_or_generated" },
    "status": { "type": "string", "enum": ["proposed", "confirmed", "active", "completed", "cancelled"], "x-field-origin": "system" },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "x-field-origin": "user_or_generated"
    },
    "constraints": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "default": [],
      "x-field-origin": "user"
    },
    "created_at": { "$ref": "tutor_common.schema.json#/$defs/timestamp", "x-field-origin": "system" },
    "updated_at": { "$ref": "tutor_common.schema.json#/$defs/timestamp", "x-field-origin": "system" },
    "approval": {
      "anyOf": [{ "$ref": "tutor_common.schema.json#/$defs/humanApproval" }, { "type": "null" }],
      "x-field-origin": "user"
    },
    "generation": {
      "anyOf": [{ "$ref": "tutor_common.schema.json#/$defs/generationProvenance" }, { "type": "null" }],
      "default": null,
      "x-field-origin": "system"
    },
    "field_origins": {
      "type": "object",
      "additionalProperties": { "$ref": "tutor_common.schema.json#/$defs/fieldOrigin" },
      "required": ["title", "description", "success_criteria"],
      "x-field-origin": "system"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["confirmed", "active", "completed"] } }, "required": ["status"] },
      "then": {
        "properties": { "approval": { "$ref": "tutor_common.schema.json#/$defs/humanApproval" } }
      }
    }
  ]
}
