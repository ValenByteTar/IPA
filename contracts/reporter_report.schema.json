{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://res023-lab/contracts/reporter_report.schema.json",
  "title": "ReporterReport",
  "description": "Periodic domain-agnostic report with emergent, source-grounded topics.",
  "type": "object", "additionalProperties": false,
  "required": ["report_id", "corpus_id", "period", "status", "categories", "cross_cutting_signals", "recommended_readings", "uncertainties", "curation_summary", "source_refs", "generation", "field_origins"],
  "properties": {
    "report_id": { "$ref": "reporter_common.schema.json#/$defs/identifier", "x-field-origin": "system" },
    "corpus_id": { "$ref": "reporter_common.schema.json#/$defs/identifier", "x-field-origin": "system" },
    "period": {
      "type": "object", "additionalProperties": false, "required": ["start", "end", "label"],
      "properties": { "start": { "$ref": "reporter_common.schema.json#/$defs/timestamp" }, "end": { "$ref": "reporter_common.schema.json#/$defs/timestamp" }, "label": { "type": "string", "minLength": 1 } }
    },
    "status": { "type": "string", "enum": ["draft", "reviewed", "published"] },
    "categories": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["category_id", "label", "description", "document_count", "source_count", "cohesion", "importance", "novelty", "evolution", "subtopics", "representative_sources", "source_refs", "document_ids", "uncertainties"],
        "properties": {
          "category_id": { "$ref": "reporter_common.schema.json#/$defs/identifier" },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "document_count": { "type": "integer", "minimum": 1 },
          "source_count": { "type": "integer", "minimum": 1 },
          "cohesion": { "type": "number", "minimum": 0, "maximum": 1 },
          "importance": { "type": "number", "minimum": 0, "maximum": 1 },
          "novelty": { "type": "number", "minimum": 0, "maximum": 1 },
          "evolution": { "type": "string", "enum": ["new", "stable", "growing", "declining", "split", "merged", "disappeared", "ambiguous"] },
          "subtopics": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "representative_sources": { "type": "array", "minItems": 1, "items": { "$ref": "reporter_common.schema.json#/$defs/sourceRef" } },
          "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "reporter_common.schema.json#/$defs/sourceRef" } },
          "generation": { "$ref": "reporter_common.schema.json#/$defs/generation" },
          "field_origins": { "type": "object", "additionalProperties": { "$ref": "reporter_common.schema.json#/$defs/origin" } },
          "document_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "reporter_common.schema.json#/$defs/identifier" } },
          "uncertainties": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "parent_categories": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["category_id", "label", "description", "subtopic_ids", "document_count", "document_ids", "importance", "cohesion", "novelty", "evolution"],
        "properties": {
          "category_id": { "$ref": "reporter_common.schema.json#/$defs/identifier" },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "subtopic_ids": { "type": "array", "minItems": 1, "items": { "$ref": "reporter_common.schema.json#/$defs/identifier" } },
          "document_count": { "type": "integer", "minimum": 1 },
          "document_ids": { "type": "array", "items": { "$ref": "reporter_common.schema.json#/$defs/identifier" } },
          "importance": { "type": "number", "minimum": 0, "maximum": 1 },
          "cohesion": { "type": "number", "minimum": 0, "maximum": 1 },
          "novelty": { "type": "number", "minimum": 0, "maximum": 1 },
          "evolution": { "type": "string", "enum": ["new", "stable", "growing", "declining", "split", "merged", "disappeared", "ambiguous"] },
          "source_refs": { "type": "array", "items": { "$ref": "reporter_common.schema.json#/$defs/sourceRef" } },
          "generation": { "$ref": "reporter_common.schema.json#/$defs/generation" }
        }
      }
    },
    "cross_cutting_signals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "recommended_readings": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["document_id", "reason", "priority"], "properties": { "document_id": { "$ref": "reporter_common.schema.json#/$defs/identifier" }, "reason": { "type": "string", "minLength": 1 }, "priority": { "type": "number", "minimum": 0, "maximum": 1 } } } },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "curation_summary": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "source_refs": { "type": "array", "items": { "$ref": "reporter_common.schema.json#/$defs/sourceRef" }, "x-field-origin": "source" },
    "generation": { "$ref": "reporter_common.schema.json#/$defs/generation", "x-field-origin": "system" },
    "field_origins": { "type": "object", "additionalProperties": { "$ref": "reporter_common.schema.json#/$defs/origin" }, "required": ["categories", "cross_cutting_signals", "recommended_readings", "uncertainties", "curation_summary"], "x-field-origin": "system" }
  }
}
