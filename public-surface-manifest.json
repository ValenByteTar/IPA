{
  "schema_version": "1.0",
  "project": "ipa",
  "public": {
    "package": "src/ipa",
    "contracts": "contracts",
    "tests": "tests",
    "fixtures": "data/sample",
    "documentation": ["README.md", "docs", "knowledge"],
    "entrypoints": ["scripts", "tools"]
  },
  "local_externalized": {
    "corpus": ["Landing", "Archive"],
    "models": ["models", "exllamav3-dev"],
    "generated": ["outputs", ".pytest_cache"],
    "archive": ["local_archive"]
  },
  "compatibility": {
    "legacy_package": null,
    "target_package": "ipa",
    "migration": "completed 2026-09-06 (res023_lab facade and root compatibility wrappers retired)"
  },
  "rules": [
    "contracts are authoritative",
    "tools are adapters",
    "generated artifacts are never runtime authority",
    "local corpus and models are not committed",
    "deletions require explicit review"
  ]
}
