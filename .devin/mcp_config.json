{
  "mcpServers": {
    "ipa-eks": {
      "command": ".venv\\Scripts\\python.exe",
      "args": ["tools/eks_mcp_server.py"],
      "env": {
        "IPA_EKS_ROOT": "knowledge"
      }
    },
    "ipa": {
      "command": ".venv\\Scripts\\python.exe",
      "args": ["-m", "ipa.mcp.mcp_server"],
      "env": {
        "PYTHONPATH": "src"
      }
    }
  }
}
