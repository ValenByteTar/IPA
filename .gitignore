# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local data, corpus, models and generated state
Landing/*
!Landing/.gitkeep
Archive/*
!Archive/.gitkeep
Transit/*
!Transit/.gitkeep
models/*
!models/.gitkeep
# exllamav3-dev: track docs and placeholder, ignore vendored source and binaries
exllamav3-dev/*
!exllamav3-dev/.gitkeep
!exllamav3-dev/.gitignore
!exllamav3-dev/README.md
outputs/*
!outputs/README.md
!outputs/.gitkeep
local_archive/

# Databases, indexes and vector stores
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.lance/
*.tantivy/

# Runtime locks (specific paths; do not use broad *.lock)
outputs/**/orchestrator.lock
outputs/web_dashboard/*.lock
outputs/experiments/E12-corpus/process_state/*.pause

# Local logs and runtime state
*.log
*.log.*

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Build artifacts
build/
dist/
*.egg-info/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
